{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8787
	# Os demais cabeçalhos de segurança (CSP, X-Frame-Options, etc.) vêm do próprio app
	header {
		# HSTS vale também para subdomínios do CRM (ex.: api.crm.suaempresa.com.br). Sem "preload": é reversível.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Outros sites desta VPS atrás do mesmo Caddy (um arquivo .caddy por site).
# Exemplo: SETUP-KIT/sites/olx-webhook.caddy.exemplo. Pasta vazia = só o CRM.
import /etc/caddy/sites/*.caddy
