{
  "name": "leadflow-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test test/csv.test.ts test/password.test.ts && npm run build:worker && npm test --prefix server",
    "test:rls": "bash supabase/test-rls.sh",
    "build:demo": "tsc -b && VITE_ROUTER=memory vite build --base=./ --outDir dist-demo",
    "build:worker": "vite build --config vite.worker.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
