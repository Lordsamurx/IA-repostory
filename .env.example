# ------------------------------------------------------------------
# LeadFlow CRM — variáveis de ambiente
# O instalador (SETUP-KIT/install.sh) gera este arquivo como .env.
# Sem VITE_SUPABASE_URL o sistema roda em MODO LOCAL (dados no navegador).
# ------------------------------------------------------------------

# Passo 4 — domínio apontado para o IP da VPS
DOMAIN=crm.suaempresa.com.br

# Passo 3.2 — Supabase → Configurações do projeto → API Keys
# (a chave anon é pública por design; a service_role NUNCA vai aqui)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Agentes de IA — usados só pelo servidor, nunca chegam ao navegador
AI_PROVIDER=anthropic   # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

# ------------------------------------------------------------------
# Automação 24 h e WhatsApp real — o SETUP-KIT/whatsapp.sh preenche tudo isto
# ------------------------------------------------------------------
# Chave service_role do Supabase: liga o worker do servidor (chatbot, IA, follow-ups,
# disparos e WhatsApp sem navegador aberto). Só o servidor lê; nunca use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API (WhatsApp por QR Code). Externa: https://evolution.seudominio.com.br
# Nesta VPS (perfil "evolution" do docker-compose): http://evolution:8080
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Prefixo das instâncias criadas pelo CRM (útil se a mesma Evolution atende outros sistemas)
EVOLUTION_INSTANCE_PREFIX=leadflow-

# Segredo que a Evolution envia ao chamar o webhook (gere com: openssl rand -hex 32)
WHATSAPP_WEBHOOK_TOKEN=
# Endereço do webhook. Padrão: https://$DOMAIN/api/whatsapp/webhook
# Com a Evolution nesta VPS: http://app:8787/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=

# Só para a Evolution nesta VPS:
# COMPOSE_PROFILES=evolution
# EVOLUTION_DB_PASSWORD=
# EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.1.1
