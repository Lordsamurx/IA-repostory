# ------------------------------------------------------------------
# LeadFlow CRM — variáveis de ambiente
# O instalador (SETUP-KIT/install.sh) gera este arquivo como .env.
# Sem VITE_SUPABASE_URL o sistema roda em MODO LOCAL (dados no navegador).
# ------------------------------------------------------------------

# Passo 4 — domínio apontado para o IP da VPS
DOMAIN=crm.suaempresa.com.br

# Passo 3.2 — Supabase → Configurações do projeto → API Keys
# (a chave anon é pública por design; a service_role NUNCA vai aqui)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Agentes de IA — usados só pelo servidor, nunca chegam ao navegador
AI_PROVIDER=anthropic   # anthropic | openai
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
